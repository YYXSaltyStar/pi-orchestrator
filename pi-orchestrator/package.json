{
  "name": "pi-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Orchestrator mode for Pi: a planning-only parent agent that delegates all execution to isolated subagents.",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": [
      "./extensions/orchestrator/index.ts",
      "./extensions/subagent/index.ts",
      "./extensions/guard/index.ts"
    ],
    "prompts": ["./prompts/*.md"]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
