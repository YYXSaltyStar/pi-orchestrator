# Normalize line endings so the repository is stable across platforms.
#
# Without this, Git's autocrlf rewrites every text file on checkout and produces
# noisy diffs. Note that the test fixture in agent-lab/sections/ originally had
# MIXED CRLF/LF endings, which is what made the first ground-truth script
# over-count lines -- keeping sources at LF here avoids reintroducing that trap.
* text=auto eol=lf

# Windows scripts are executable by extension; keep them as text.
*.ps1 text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.pdf binary
*.zip binary
*.woff2 binary
